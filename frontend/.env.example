# --- Frontend environment (Vite) ---
# Base URL of the KYC backend API, WITHOUT a trailing /api segment.
# The app appends /api (and /api/admin) itself.
#
# Local development: leave this blank — the app defaults to http://localhost:5000.
# Production: point it at your deployed backend origin, e.g.
#   VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=
