# Server Port
PORT=5000

# Database Configuration
# Replace with your MongoDB Atlas Connection String
MONGODB_URI=mongodb://localhost:27017/kyc-verification

# Mock Mode Configuration (Set to 'true' to run without external API keys)
MOCK_MODE=true

# --- External Services (only needed when MOCK_MODE=false) ---
# OCR: Gemini is the primary provider; Google Vision is the fallback.
GEMINI_API_KEY=mock
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here
# Face detection, cropping, and comparison (Face++)
FACEPLUSPLUS_API_KEY=your_faceplusplus_api_key_here
FACEPLUSPLUS_API_SECRET=your_faceplusplus_api_secret_here

# --- Admin Dashboard ---
# Shared secret required to sign in to the admin dashboard and to call
# every /api/admin/* endpoint. Use a long random string in any real deployment.
ADMIN_TOKEN=change-me

# --- PII Security ---
# Server-side pepper mixed into the Aadhaar hash before storage. Keep it secret
# and stable: changing it makes previously stored hashes non-matchable, which
# breaks distinct-applicant analytics for older records.
AADHAAR_HASH_PEPPER=change-me
